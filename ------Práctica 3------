-Parte 5: Instalación y Configuración de Keepalived
[En el Nodo 1 y 2]:
sudo dnf install keepalived -y
sudo nano /etc/keepalived/keepalived.conf

#Configuracion para keepalived
global_defs {
    router_id NODO1
}

vrrp_instance VI_1 {
    state MASTER
    interface ens33
    virtual_router_id 51
    priority 100
    advert_int 1

    virtual_ipaddress {
        192.168.126.125/24
    }
}


global_defs {
    router_id NODO2
}

vrrp_instance VI_1 {
    state BACKUP
    interface ens33
    virtual_router_id 51
    priority 50
    advert_int 1

    virtual_ipaddress {
        192.168.126.125/24
    }
}

-Parte 6: Inicio de Keepalived y Pruebas de Conectividad
[En el Nodo 1]:
sudo systemctl start keepalived
sudo systemctl status keepalived

